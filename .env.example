# 복사해서 `.env.local` 로 저장해 쓰면 됩니다 (.env.local 은 Git에 안 올라감).
# 줄마다 뜻은 아래 주석 참고.

# Sanity — 원격에 글/미디어 상자 두는 서비스. 아직 미사용이면 빈 칸 두면 됨.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ── 관리자 로그인 (서버만 읽음. NEXT_PUBLIC 붙이면 안 됨) ──
#
# ADMIN_SESSION_SECRET
#   로그인 토큰을 만드는「긴 임의 문자열». 본 서버만 알아야 함.
ADMIN_SESSION_SECRET=
#
# 계정 방법 A — 여러 명: ADMIN_USERS 한 줄 배열 형식(JSON). 실제 값은 로컬에만 두기.
# ADMIN_USERS=[{"username":"직원아이디","password":"직원비번"}]
#
# 계정 방법 B — 한 명만:
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# ── CMS 영속 저장 (Vercel 프로덕션 필수) ──
# Vercel 대시보드 → Storage → Upstash Redis → 이 프로젝트에 Connect
# 연동하면 아래 변수가 자동 주입됩니다 (이름은 둘 중 하나 세트).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# 로컬 개발: 위 변수 없으면 src/data/*.json 파일에 저장 (git commit 가능).
# sejongsound.org: Redis 연동 후 관리자 저장 → 클라우드에 영구 보관.
# Gmail / Google Workspace 예시 — 2단계 인증 후「앱 비밀번호」발급 필요
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=발송용@gmail.com
# SMTP_PASS=앱비밀번호16자
# CONTACT_TO=sejong@sejongkorea.org
# ADMIN_CONTACT_TO=개발자@gmail.com
